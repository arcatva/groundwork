{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reviewers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "before": {
            "description": "what the reviewer reads before its rule files",
            "type": "string"
          },
          "files": {
            "description": "its rule files, under standard/",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "question": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "question"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "minLength": 1,
            "type": "string"
          },
          "read_when": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "file",
          "read_when"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "the steps it may follow",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "file": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "produces": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "description": "a session may begin here",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "produces",
          "file"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "title": "The skill's index: its steps, reviewers and rule files",
  "type": "object"
}
